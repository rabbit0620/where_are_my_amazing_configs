set encoding=utf-8

set fileencodings=utf-8,ucs-bom,gb18030,gbk,gb2312,cp936

set termencoding=utf-8 

" Enable line numbers
set number

" Syntax highlighting (essential for code)
syntax on

" Use 4 spaces for indentation
set tabstop=4
set shiftwidth=4
set expandtab

" Enable search highlighting
set hlsearch
set incsearch

" Always show the status line
set laststatus=2

" Enable mouse support
set mouse=a
